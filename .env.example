# Copy to .env and fill in locally. Never commit real values.

# Provider switches (configuration only)
LLM_PROVIDER=mistral   # mistral | ollama
OCR_PROVIDER=mistral   # mistral | docling

# Web -> API (Docker Compose: http://api:8000)
API_BASE_URL=http://localhost:8000

# Supabase (Frankfurt)
SUPABASE_URL=https://lhpmtmcsbtmmksstaocl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=   # bypasses RLS: seed/reset only, never in the browser

# Zitadel (OIDC)
OIDC_ISSUER=https://pflege-posteingang-demo-bnizeb.eu1.zitadel.cloud

# Database (pooler; written by apps/api/scripts/provision_db_roles.py)
